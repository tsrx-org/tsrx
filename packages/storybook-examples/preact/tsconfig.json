{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@tsrx/typescript-plugin"
      }
    ]
  },
  "tsrx": {
    "compiler": "@tsrx/preact",
    "platform": "web"
  },
  "include": ["*.ts", "*.tsx", "*.tsrx", ".storybook/*.ts"]
}
