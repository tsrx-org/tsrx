    "@storybook/preact-vite": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@storybook/vue3-vite": "10.6.2",
    "@tsrx/content-mapper": "workspace:*",
    "@tsrx/hono": "workspace:*",
    "@tsrx/preact": "workspace:*",
    "@tsrx/react": "workspace:*",
    "@tsrx/ripple": "catalog:default",
    "@tsrx/solid": "workspace:*",
    "@tsrx/typescript-plugin": "workspace:*",
    "@tsrx/vite-plugin-hono": "workspace:*",
    "@tsrx/vite-plugin-preact": "workspace:*",
    "@tsrx/vite-plugin-react": "workspace:*",
    "@tsrx/vite-plugin-solid": "workspace:*",
    "@tsrx/vite-plugin-vue": "workspace:*",
    "@tsrx/vue": "workspace:*",
    "@types/node": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "hono": "^4.13.7",
    "preact": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "ripple": "catalog:default",
