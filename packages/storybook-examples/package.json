{
  "name": "@tsrx/storybook-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:react": "cd react && storybook dev --no-open",
    "build:react": "cd react && storybook build --output-dir dist",
    "dev:preact": "cd preact && storybook dev --no-open",
    "build:preact": "cd preact && storybook build --output-dir dist",
    "dev:solid": "cd solid && storybook dev --no-open",
    "build:solid": "cd solid && storybook build --output-dir dist",
    "dev:vue": "cd vue && storybook dev --no-open",
    "build:vue": "cd vue && storybook build --output-dir dist",
    "dev:hono": "cd hono && storybook dev --no-open",
    "build:hono": "cd hono && storybook build --output-dir dist",
    "dev:ripple": "cd ripple && storybook dev --no-open",
    "build:ripple": "cd ripple && storybook build --output-dir dist",
    "typecheck": "node scripts/typecheck.js",
    "test": "node --test e2e/storybook.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@ripple-ts/vite-plugin": "catalog:default",
    "@solidjs/web": "catalog:default",
