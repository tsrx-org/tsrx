{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./src/", "./scripts/", "./tests/*.js"],
  "exclude": ["node_modules", "dist"]
}
