// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`declare-class-fields.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
class B {p: number;}
class C extends B {declare p: 256 | 1000;}
class D {
  declare field = "field";
}
declare class D {
  field = "field";
}

=====================================output=====================================
class B {
  p: number;
}
class C extends B {
  declare p: 256 | 1000;
}
class D {
  declare field = "field";
}
declare class D {
  field = "field";
}

================================================================================
`;

exports[`declare-enum.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare const enum Foo {}
declare enum Bar {}

=====================================output=====================================
declare const enum Foo {}
declare enum Bar {}

================================================================================
`;

exports[`declare-function.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare function x();
declare function y(): void;

declare namespace A {
    function x();
    function y(): void;
}

declare function f([]?)

=====================================output=====================================
declare function x();
declare function y(): void;

declare namespace A {
  function x();
  function y(): void;
}

declare function f([]?);

================================================================================
`;

exports[`declare-get-set-field.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
class C {
  declare get: string
  declare set: string;
}

=====================================output=====================================
class C {
  declare get: string;
  declare set: string;
}

================================================================================
`;

exports[`declare-interface.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
declare interface Dictionary<T> {
  [index: string]: T
}

declare interface B {
  foo([]?): void;
  bar({}, []?): any;
  baz(a: string, b: number, []?): void;
}

=====================================output=====================================
declare interface Dictionary<T> {
  [index: string]: T;
}

declare interface B {
  foo([]?): void;
  bar({}, []?): any;
  baz(a: string, b: number, []?): void;
}

================================================================================
`;

