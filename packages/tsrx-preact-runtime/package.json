{
  "name": "@tsrx/preact-runtime",
  "description": "Runtime helpers for TSRX Preact compiled output",
  "license": "MIT",
  "author": "Dominic Gannaway",
  "version": "0.1.4",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/tsrx.git",
    "directory": "packages/tsrx-preact-runtime"
  },
  "exports": {
    "./error-boundary": {
      "types": "./types/error-boundary.d.ts",
      "default": "./src/error-boundary.js"
    },
    "./ref": {
      "types": "./types/ref.d.ts",
      "default": "./src/ref.js"
    },
    "./iterable": {
      "types": "./types/iterable.d.ts",
      "default": "./src/iterable.js"
    }
  },
  "dependencies": {
    "@tsrx/runtime": "workspace:*"
  },
  "peerDependencies": {
    "preact": ">=10"
  },
  "files": [
    "src",
    "types"
  ]
}
