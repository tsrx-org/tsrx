{
  "name": "@tsrx/vscode-plugin",
  "displayName": "TSRX Syntax for VS Code",
  "publisher": "TSRX",
  "description": "TSRX JavaScript/TypeScript language support",
  "version": "2.0.78",
  "private": true,
  "author": "Dominic Gannaway",
  "license": "MIT",
  "engines": {
    "vscode": "^1.97.0"
  },
  "homepage": "https://tsrx.dev/",
  "activationEvents": [
    "workspaceContains:**/*.tsrx"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "dist/extension.js",
  "type": "module",
  "icon": "icons/logo.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/tsrx.git",
    "directory": "packages/vscode-plugin"
  },
  "scripts": {
    "build": "tsdown",
    "repack-vsix": "node scripts/repack-vsix.js",
    "delete-unpacked": "node ../../scripts/remove.js packages/vscode-plugin/vscode-plugin",
    "pkg-name-release": "node ../../scripts/transform-package.js packages/vscode-plugin/package.json name tsrx-vscode-plugin",
    "pkg-name-back": "node ../../scripts/transform-package.js packages/vscode-plugin/package.json name @tsrx/vscode-plugin",
    "package": "pnpm delete-unpacked && pnpm pkg-name-release && (node ../../scripts/regenerate-textmate && vsce package --no-dependencies --out=vscode-plugin.vsix && pnpm repack-vsix; status=$?; pnpm pkg-name-back || exit $?; exit $status)",
    "install-package": "code --install-extension vscode-plugin.vsix",
    "build-and-package": "pnpm build && pnpm package",
    "build-package-and-install": "pnpm build && pnpm package && pnpm install-package",
    "build-package-install-and-run": "pnpm build && pnpm package && pnpm install-package && code"
  },
  "dependencies": {
    "@volar/language-core": "catalog:default",
    "@volar/language-server": "catalog:default",
    "@volar/typescript": "catalog:default",
    "@volar/vscode": "catalog:default",
    "@tsrx/language-server": "workspace:*",
    "@tsrx/typescript-plugin": "workspace:*",
    "volar-service-typescript": "catalog:default",
    "vscode-languageclient": "catalog:default",
    "vscode-uri": "catalog:default"
  },
  "// @types/vscode": "Keep in `peerDependencies` - prevent vsix compatibility, but it's a dev dep",
  "peerDependencies": {
    "typescript": "catalog:vscode",
    "@types/vscode": "catalog:default"
  },
  "devDependencies": {
    "tsdown": "catalog:default",
    "@vscode/vsce": "catalog:default",
    "adm-zip": "catalog:default",
    "@types/adm-zip": "catalog:default",
    "ovsx": "catalog:default"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "tsrx"
      }
    ],
    "configuration": {
      "title": "TSRX",
      "properties": {
        "tsrx.autoClosingTags.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert closing tags when typing '>' after a tag name. Note: For TSRX files, you may also need to set 'javascript.autoClosingTags' and 'typescript.autoClosingTags' to false to fully disable this feature."
        },
        "tsrx.preferences.preferTypeOnlyAutoImports": {
          "type": "boolean",
          "default": true,
          "description": "Prefer adding 'type' modifier to auto imports when possible"
        },
        "tsrx.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable default TSRX formatter"
        }
      }
    },
    "commands": [
      {
        "command": "tsrx.goToSourceDefinition",
        "title": "Go to Source Definition",
        "category": "TSRX"
      }
    ],
    "languages": [
      {
        "id": "tsrx",
        "aliases": [
          "TSRX",
          "tsrx"
        ],
        "extensions": [
          ".tsrx"
        ],
        "icon": {
          "light": "icons/logo.png",
          "dark": "icons/logo.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "tsrx": "html"
      },
      "emmet.showExpandedAbbreviation": "always"
    },
    "grammars": [
      {
        "language": "tsrx",
        "scopeName": "source.tsrx",
        "path": "./syntaxes/tsrx.tmLanguage.json",
        "embeddedLanguages": {
          "source.js.embedded.tsrx": "javascriptreact",
          "source.js.embedded.tsrx-isolated": "javascript",
          "source.css": "css",
          "source.ts": "typescript"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tsrx.goToSourceDefinition",
          "when": "tsSupportsSourceDefinition && resourceLangId == tsrx",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "typescript.findAllFileReferences",
          "when": "tsSupportsFileReferences && resourceLangId == tsrx",
          "group": "4_search"
        }
      ],
      "editor/title/context": [
        {
          "command": "typescript.findAllFileReferences",
          "when": "tsSupportsFileReferences && resourceLangId == tsrx"
        }
      ],
      "commandPalette": [
        {
          "command": "typescript.reloadProjects",
          "when": "editorLangId == tsrx && typescript.isManagedFile"
        },
        {
          "command": "typescript.goToProjectConfig",
          "when": "editorLangId == tsrx && typescript.isManagedFile"
        },
        {
          "command": "typescript.sortImports",
          "when": "supportedCodeAction =~ /(\\s|^)source\\.sortImports\\b/ && editorLangId =~ /^tsrx$/"
        },
        {
          "command": "typescript.removeUnusedImports",
          "when": "supportedCodeAction =~ /(\\s|^)source\\.removeUnusedImports\\b/ && editorLangId =~ /^tsrx$/"
        }
      ]
    }
  }
}
