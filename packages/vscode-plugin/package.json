{
  "name": "@tsrx/vscode-plugin",
  "displayName": "TSRX Syntax for VS Code",
  "publisher": "TSRX",
  "description": "TSRX JavaScript/TypeScript language support",
  "version": "2.2.3",
  "private": true,
  "author": "Dominic Gannaway",
  "license": "MIT",
  "engines": {
    "vscode": "^1.97.0"
  },
  "homepage": "https://tsrx.dev/",
  "activationEvents": [
    "onLanguage:tsrx",
    "workspaceContains:**/*.tsrx"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TSRX target compilers and the TypeScript content mapper execute code from the workspace, so TSRX language features are only available in trusted workspaces."
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "dist/extension.js",
  "type": "module",
  "icon": "icons/logo.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/tsrx.git",
    "directory": "packages/vscode-plugin"
  },
  "scripts": {
    "build": "pnpm --filter \"@tsrx/vscode-plugin^...\" build && tsdown",
    "repack-vsix": "node scripts/repack-vsix.js",
    "delete-unpacked": "node ../../scripts/remove.js packages/vscode-plugin/vscode-plugin",
    "pkg-name-release": "node ../../scripts/transform-package.js packages/vscode-plugin/package.json name tsrx-vscode-plugin",
    "pkg-name-back": "node ../../scripts/transform-package.js packages/vscode-plugin/package.json name @tsrx/vscode-plugin",
    "package": "pnpm delete-unpacked && pnpm pkg-name-release && (node ../../scripts/regenerate-textmate && vsce package --no-dependencies --out=vscode-plugin.vsix && pnpm repack-vsix; status=$?; pnpm pkg-name-back || exit $?; exit $status)",
    "install-package": "code --install-extension vscode-plugin.vsix",
    "build-and-package": "pnpm build && pnpm package",
    "build-package-and-install": "pnpm build && pnpm package && pnpm install-package",
    "build-package-install-and-run": "pnpm build && pnpm package && pnpm install-package && code",
    "test:editor": "node editor-tests/run.js"
  },
  "dependencies": {
    "@tsrx/language-server": "workspace:*",
    "jsonc-parser": "catalog:default",
    "@tsrx/typescript-plugin": "workspace:*",
    "@volar/language-core": "catalog:default",
    "@volar/language-server": "catalog:default",
    "@volar/typescript": "catalog:default",
    "@volar/vscode": "catalog:default",
    "volar-service-typescript": "catalog:default",
    "vscode-languageclient": "catalog:default",
    "vscode-uri": "catalog:default"
  },
  "// @types/vscode": "Keep in `peerDependencies` - prevent vsix compatibility, but it's a dev dep",
  "peerDependencies": {
    "@types/vscode": "catalog:default"
  },
  "devDependencies": {
    "@tsrx/core": "workspace:*",
    "tsdown": "catalog:default",
    "@vscode/vsce": "catalog:default",
    "adm-zip": "catalog:default",
    "@types/adm-zip": "catalog:default",
    "ovsx": "catalog:default",
    "shiki": "catalog:"
  },
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@tsrx/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": [
          "tsrx"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tsrx"
      }
    ],
    "configuration": {
      "title": "TSRX",
      "properties": {
        "tsrx.autoClosingTags.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Close tags when typing `>` in `.tsrx` files on TypeScript 7, which does not close them there yet ([microsoft/TypeScript#64564](https://github.com/microsoft/TypeScript/issues/64564)). With VS Code's built-in TypeScript, TypeScript closes them instead (`#js/ts.autoClosingTags.enabled#`)."
        },
        "tsrx.format.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format `.tsrx` files with the project's Prettier and `@tsrx/prettier-plugin`. Both must be installed in the project. The TSRX extension is the default formatter for `.tsrx` files (`#editor.defaultFormatter#`)."
        }
      }
    },
    "commands": [
      {
        "command": "tsrx.restartServer",
        "title": "Restart Language Server",
        "category": "TSRX"
      },
      {
        "command": "tsrx.goToSourceDefinition",
        "title": "Go to Source Definition",
        "category": "TSRX"
      },
      {
        "command": "tsrx.goToProjectConfig",
        "title": "Go to Project Configuration",
        "category": "TSRX"
      },
      {
        "command": "tsrx.sortImports",
        "title": "Sort Imports",
        "category": "TSRX"
      },
      {
        "command": "tsrx.removeUnusedImports",
        "title": "Remove Unused Imports",
        "category": "TSRX"
      }
    ],
    "languages": [
      {
        "id": "tsrx",
        "aliases": [
          "TSRX",
          "tsrx"
        ],
        "extensions": [
          ".tsrx"
        ],
        "icon": {
          "light": "icons/logo.png",
          "dark": "icons/logo.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[tsrx]": {
        "editor.defaultFormatter": "TSRX.tsrx-vscode-plugin"
      },
      "emmet.includeLanguages": {
        "tsrx": "html"
      },
      "emmet.showExpandedAbbreviation": "always"
    },
    "grammars": [
      {
        "language": "tsrx",
        "scopeName": "source.tsrx",
        "path": "./syntaxes/tsrx.tmLanguage.json",
        "embeddedLanguages": {
          "source.js.embedded.tsrx": "javascriptreact",
          "source.js.embedded.tsrx-isolated": "javascript",
          "source.css": "css",
          "source.ts": "typescript"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tsrx.goToSourceDefinition",
          "when": "resourceLangId == tsrx",
          "group": "navigation@1.41"
        }
      ],
      "commandPalette": [
        {
          "command": "tsrx.restartServer",
          "when": "tsrx.active"
        },
        {
          "command": "tsrx.goToSourceDefinition",
          "when": "editorLangId == tsrx"
        },
        {
          "command": "tsrx.goToProjectConfig",
          "when": "editorLangId == tsrx"
        },
        {
          "command": "tsrx.sortImports",
          "when": "editorLangId == tsrx && supportedCodeAction =~ /(\\s|^)source\\.sortImports\\b/"
        },
        {
          "command": "tsrx.removeUnusedImports",
          "when": "editorLangId == tsrx && supportedCodeAction =~ /(\\s|^)source\\.removeUnusedImports\\b/"
        }
      ]
    }
  }
}
