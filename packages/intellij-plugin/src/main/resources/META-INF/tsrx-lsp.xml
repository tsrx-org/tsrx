<idea-plugin>
	<extensions defaultExtensionNs="com.intellij.platform.lsp">
		<serverSupportProvider implementation="dev.tsrx.intellij_plugin.TsrxLspServerSupportProvider"/>
	</extensions>
	<!-- The settings only change how the language server starts, so they load with the LSP module. -->
	<extensions defaultExtensionNs="com.intellij">
		<projectService serviceImplementation="dev.tsrx.intellij_plugin.TsrxSettings"/>
		<projectConfigurable parentId="language" id="tsrx.intellij-plugin.settings" displayName="TSRX"
							 instance="dev.tsrx.intellij_plugin.TsrxSettingsConfigurable" nonDefaultProject="true"/>
	</extensions>
</idea-plugin>
