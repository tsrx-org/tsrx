<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://tsrx.dev/">
	<!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
	<id>tsrx.intellij-plugin</id>

	<!-- Public plugin name should be written in Title Case.
			 Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
	<name>TSRX</name>

	<!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
	<vendor url="https://github.com/tsrx-org/tsrx">TSRX</vendor>

	<!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
			 Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
	<description><![CDATA[
		<p>TSRX language support for IntelliJ-based IDEs.</p>
		<p>All compatible IDEs receive the TSRX file type, commenting support, and TextMate syntax highlighting.
		Supported commercial IDEs also integrate with the TSRX language server for diagnostics, completion,
		navigation, and formatting.</p>
		<p><a href="https://github.com/tsrx-org/tsrx">Source code</a>. Released under the MIT License.</p>
    ]]></description>

	<!-- Product and plugin compatibility requirements.
			 Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
	<depends>com.intellij.modules.platform</depends>
	<depends>org.jetbrains.plugins.textmate</depends>
	<depends optional="true" config-file="tsrx-ultimate.xml">com.intellij.modules.ultimate</depends>
	<!-- Extensions defined by the plugin.
			 Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
	<extensions defaultExtensionNs="com.intellij">
		<fileType name="TSRX" implementationClass="dev.tsrx.intellij_plugin.TsrxFileType" fieldName="INSTANCE"
					 language="TSRX" extensions="tsrx"/>
		<lang.commenter language="TSRX" implementationClass="dev.tsrx.intellij_plugin.TsrxCommenter"/>
		<lang.syntaxHighlighterFactory language="TSRX"
									 implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
		<editorHighlighterProvider filetype="TSRX"
								 implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
		<textmate.bundleProvider implementation="dev.tsrx.intellij_plugin.TsrxTextMateBundleProvider"/>
		<notificationGroup id="TSRX" displayType="BALLOON" isLogByDefault="true"/>
	</extensions>
</idea-plugin>
