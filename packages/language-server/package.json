{
  "name": "@tsrx/language-server",
  "version": "0.3.130",
  "description": "Language Server Protocol implementation for TSRX",
  "main": "dist/server.js",
  "types": "types/server.d.ts",
  "exports": {
    ".": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "tsrx-language-server": "dist/language-server.js"
  },
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Dominic Gannaway",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/tsrx.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://tsrx.dev/",
  "bugs": {
    "url": "https://github.com/tsrx-org/tsrx/issues"
  },
  "dependencies": {
    "@volar/language-server": "catalog:default",
    "@tsrx/typescript-plugin": "workspace:*",
    "@tsrx/core": "workspace:*",
    "volar-service-css": "catalog:default",
    "volar-service-typescript": "catalog:default",
    "vscode-languageserver-textdocument": "catalog:default",
    "vscode-uri": "catalog:default"
  },
  "devDependencies": {
    "tsdown": "catalog:default",
    "@types/estree": "catalog:default",
    "@volar/language-core": "catalog:default",
    "@volar/language-service": "catalog:default"
  },
  "peerDependencies": {
    "typescript": "catalog:peer"
  },
  "publishConfig": {
    "access": "public"
  }
}
