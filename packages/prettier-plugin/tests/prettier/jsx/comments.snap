/>;

================================================================================
`;

exports[`jsx-tag-comment-after-prop.js - {"bracketSameLine":true} format 1`] = `
====================================options=====================================
bracketSameLine: true
parsers: ["flow", "babel", "typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
// https://github.com/typescript-eslint/typescript-eslint/pull/703

const pure = () => {
  return (
      <Foo
        // one
        foo={123}
        // two
        bar="woof"
      />
  );
}
=====================================output=====================================
// https://github.com/typescript-eslint/typescript-eslint/pull/703

const pure = () => {
  return (
    <Foo
      // one
      foo={123}
      // two
      bar="woof"
    />
  );
};

================================================================================
`;

