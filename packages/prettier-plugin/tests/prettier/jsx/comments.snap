// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`eslint-disable.js - {"bracketSameLine":true} format 1`] = `
====================================options=====================================
bracketSameLine: true
parsers: ["flow", "babel", "typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
const render = items => (
  <div>{ /* eslint-disable */
    	 items.map(item => null)
      /* eslint-enable */    }</div>
)

=====================================output=====================================
const render = (items) => (
  <div>
    {
      /* eslint-disable */
      items.map((item) => null)
      /* eslint-enable */
    }
  </div>
);

================================================================================
`;

exports[`in-attributes.js - {"bracketSameLine":true} format 1`] = `
====================================options=====================================
bracketSameLine: true
parsers: ["flow", "babel", "typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<div
  attr=/* comment */"foo"
></div>;

<div
  attr=
  /* comment */
  "foo"
></div>;

<div
  attr= /* comment */
  "foo"
></div>;

<div
  attr=
  /* comment */ "foo"
></div>;

<div
  attr=
  // comment
  "foo"
></div>;

<div
  attr= // comment
  "foo"
></div>;

=====================================output=====================================
<div attr=/* comment */ "foo"></div>;

<div attr=/* comment */
"foo"></div>;

<div attr /* comment */="foo"></div>;

<div attr=/* comment */ "foo"></div>;

<div attr=// comment
"foo"></div>;

<div attr="foo"></div>; // comment

================================================================================
`;

exports[`in-tags.js - {"bracketSameLine":true} format 1`] = `
