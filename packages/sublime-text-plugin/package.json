{
  "name": "@tsrx/sublime-text-plugin",
  "version": "0.0.82",
  "description": "Sublime Text support for TSRX",
  "private": true,
  "keywords": [
    "sublime-text",
    "sublime",
    "plugin",
    "tsrx"
  ],
  "scripts": {
    "update-lock": "cd src/language-server && npm install --package-lock-only",
    "build": "npm run update-lock && node ./scripts/build.js",
    "test:editor": "node editor-tests/run.mjs"
  },
  "author": "Dominic Gannaway",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/tsrx.git",
    "directory": "packages/sublime-text-plugin"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/js-yaml": "^4.0.9",
    "adm-zip": "^0.5.16",
    "js-yaml": "^4.1.0"
  }
}
